{
  "name": "tic-tac-toe",
  "mode": "architecture",
  "timeoutSeconds": 1200,
  "runJudge": true,
  "runQualitativeJudge": false,
  "expectedOutputs": {
    "html": [
      "tictactoe.html"
    ],
    "tests": [
      "tictactoe.test.js",
      "*.test.js"
    ],
    "docs": [
      "README.md"
    ]
  },
  "tools": {
    "claude": {
      "enabled": true,
      "requestedModel": "claude-sonnet-4-5",
      "expectedModels": [
        "claude-sonnet-4-5"
      ],
      "requiredModels": [
        "claude-sonnet-4-5"
      ],
      "allowAdditionalModels": true
    },
    "codex": {
      "enabled": true,
      "requestedModel": "gpt-5.5",
      "expectedModels": [
        "gpt-5.5"
      ],
      "requiredModels": [
        "gpt-5.5"
      ],
      "allowAdditionalModels": true
    },
    "opencode": {
      "enabled": true,
      "requestedModel": "openai-via-gateway/gpt-5",
      "expectedModels": [
        "gpt-5",
        "gpt-5-mini"
      ],
      "requiredModels": [
        "gpt-5",
        "gpt-5-mini"
      ],
      "allowAdditionalModels": true,
      "requireRouting": true
    }
  }
}
