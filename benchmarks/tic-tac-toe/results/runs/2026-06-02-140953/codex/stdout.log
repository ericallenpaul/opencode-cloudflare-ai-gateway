 doc.querySelector('button[data-index=\"' + index + '\"]');\n        if (!button) { throw new Error(\"Missing cell \" + index); }\n        button.click();\n      });\n      await sleep(100);\n      var afterWin = read(doc);\n      iframe.addEventListener(\"load\", async function secondLoad() {\n        try {\n          await sleep(100);\n          var doc2 = iframe.contentDocument;\n          if (!doc2) { throw new Error(\"Cannot access iframe document after reload\"); }\n          var afterReload = read(doc2);\n          finish({\n            initial: initial,\n            afterWin: afterWin,\n            afterReload: afterReload,\n            checks: {\n              hasNineCells: initial.cells === 9,\n              startsWithX: initial.status === \"Player X to move.\",\n              xWins: afterWin.status === \"Player X wins.\",\n              highlightsWin: afterWin.winCells === 3,\n              scoreIncremented: afterWin.x === initial.x + 1,\n              otherScoresUnchanged: afterWin.o === initial.o && afterWin.draws === initial.draws,\n              scorePersistedAfterReload: afterReload.x === afterWin.x && afterReload.o === afterWin.o && afterReload.draws === afterWin.draws,\n              reloadStartsRound: afterReload.status === \"Player X to move.\"\n            }\n          });\n        } catch (error) { fail(error); }\n      }, { once: true });\n      iframe.contentWindow.location.reload();\n    } catch (error) { fail(error); }\n  }, { once: true });\n}());\n</script>`;\nawait fsEdgeFinal.writeFile(harnessPathFinal, harnessHtmlFinal, \"utf8\");\nconst harnessUrlFinal = pathToFileURLEdgeFinal(harnessPathFinal).href;\nconst harness = await runEdgeFinal(edgeExeFinal, [\n  \"--headless=new\",\n  \"--disable-gpu\",\n  \"--no-first-run\",\n  \"--no-default-browser-check\",\n  \"--allow-file-access-from-files\",\n  `--user-data-dir=${harnessProfileFinal}`,\n  \"--virtual-time-budget=10000\",\n  \"--dump-dom\",\n  harnessUrlFinal\n], { windowsHide: true, timeout: 30000, maxBuffer: 8 * 1024 * 1024 });\nconst resultMatchFinal = harness.stdout.match(/<pre id=\"result\">([^<]*)<\\/pre>/);\nlet parsedFinal = null;\nif (resultMatchFinal) {\n  const htmlTextFinal = resultMatchFinal[1].replace(/&quot;/g, '\"').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>');\n  try { parsedFinal = JSON.parse(htmlTextFinal); } catch (error) { parsedFinal = { parseError: error.message, raw: htmlTextFinal }; }\n}\nnodeRepl.write(JSON.stringify({\n  directFileLoad: { exitCode: 0, checks: directChecksFinal, stderrExcerpt: direct.stderr.slice(0, 500) },\n  interactionPersistence: { exitCode: 0, dataResultPass: harness.stdout.includes('data-result=\"pass\"'), parsed: parsedFinal, stderrExcerpt: harness.stderr.slice(0, 500) }\n}, null, 2));","timeout_ms":60000},"result":{"content":[{"type":"text","text":"{\n  \"directFileLoad\": {\n    \"exitCode\": 0,\n    \"checks\": {\n      \"loadedTitle\": true,\n      \"renderedHeading\": true,\n      \"renderedBoard\": true,\n      \"renderedStatus\": true,\n      \"noFatalStdErr\": true\n    },\n    \"stderrExcerpt\": \"\"\n  },\n  \"interactionPersistence\": {\n    \"exitCode\": 0,\n    \"dataResultPass\": true,\n    \"parsed\": {\n      \"initial\": {\n        \"status\": \"Player X to move.\",\n        \"x\": 0,\n        \"o\": 0,\n        \"draws\": 0,\n        \"cells\": 9,\n        \"winCells\": 0\n      },\n      \"afterWin\": {\n        \"status\": \"Player X wins.\",\n        \"x\": 1,\n        \"o\": 0,\n        \"draws\": 0,\n        \"cells\": 9,\n        \"winCells\": 3\n      },\n      \"afterReload\": {\n        \"status\": \"Player X to move.\",\n        \"x\": 1,\n        \"o\": 0,\n        \"draws\": 0,\n        \"cells\": 9,\n        \"winCells\": 0\n      },\n      \"checks\": {\n        \"hasNineCells\": true,\n        \"startsWithX\": true,\n        \"xWins\": true,\n        \"highlightsWin\": true,\n        \"scoreIncremented\": true,\n        \"otherScoresUnchanged\"