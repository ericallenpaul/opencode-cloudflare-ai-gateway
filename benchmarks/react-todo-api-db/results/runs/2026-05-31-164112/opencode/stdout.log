ev.concat(t)); })\n37:         .catch(err => setError(err.body || 'Error'));\n38:     }\n39: \n40:     function updateTodo(id, newTitle) {\n41:       setError(null);\n42:       api('/api/todos/' + id, { method: 'PUT', body: JSON.stringify({ title: newTitle }) })\n43:         .then(updated => setTodos(prev => prev.map(p => p.id === updated.id ? updated : p)))\n44:         .catch(err => setError(err.body || 'Error'));\n45:     }\n46: \n47:     function toggleTodo(id) {\n48:       setError(null);\n49:       api('/api/todos/' + id + '/toggle', { method: 'PATCH' })\n50:         .then(updated => setTodos(prev => prev.map(p => p.id === updated.id ? updated : p)))\n51:         .catch(err => setError(err.body || 'Error'));\n52:     }\n53: \n54:     function deleteTodo(id) {\n55:       setError(null);\n56:       api('/api/todos/' + id, { method: 'DELETE' })\n57:         .then(() => setTodos(prev => prev.filter(p => p.id !== id)))\n58:         .catch(err => setError(err.body || 'Error'));\n59:     }\n60: \n61:     return e('div', { style: { maxWidth: 600, margin: '20px auto', fontFamily: 'sans-serif' } },\n62:       e('h2', null, 'Todos'),\n63:       e('form', { onSubmit: addTodo, style: { marginBottom: 12 } },\n64:         e('input', { placeholder: 'Enter todo title', value: title, onChange: (e) => setTitle(e.target.value), 'aria-label': 'todo title', style: { width: '70%', padding: 8 } }),\n65:         e('button', { type: 'submit', style: { marginLeft: 8, padding: '8px 12px' } }, 'Add')\n66:       ),\n67:       loading && e('div', null, 'Loading...'),\n68:       error && e('div', { style: { color: 'red', marginBottom: 8 } }, typeof error === 'string' ? error : JSON.stringify(error)),\n69:       !loading && todos.length === 0 && e('div', null, 'No todos yet'),\n70:       e('ul', null, todos.map(todo => e(TodoItem, { key: todo.id, todo, onToggle: toggleTodo, onDelete: deleteTodo, onSave: updateTodo })))\n71:     );\n72:   }\n73: \n74:   function TodoItem({ todo, onToggle, onDe