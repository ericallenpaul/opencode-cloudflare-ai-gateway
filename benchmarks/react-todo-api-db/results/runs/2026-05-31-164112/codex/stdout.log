{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command '$ErrorActionPreference = '\"'Stop'\n\"'$workspace = (Get-Location).Path\n$port = 39117\n$dbPath = Join-Path $workspace '\"'data\\\\verification-restart.sqlite'\nRemove-Item -LiteralPath \"'$dbPath -Force -ErrorAction SilentlyContinue\n\nfunction Stop-ServerJob($job, $port) {\n  if ($job) {\n    Stop-Job -Job $job -ErrorAction SilentlyContinue | Out-Null\n    Remove-Job -Job $job -Force -ErrorAction SilentlyContinue\n  }\n  Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue | ForEach-Object {\n    Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue\n  }\n}\n\nfunction Start-App($workspace, $port, $dbPath) {\n  $job = Start-Job -ScriptBlock {\n    param($workspace, $port, $dbPath)\n    Set-Location $workspace\n    $env:PORT = [string]$port\n    $env:TODO_DB_PATH = $dbPath\n    npm.cmd start\n  } -ArgumentList $workspace, $port, $dbPath\n\n  $ready = $false\n  for ($i = 0; $i -lt 40; $i++) {\n    Start-Sleep -Milliseconds 250\n    try {\n      $health = Invoke-RestMethod -Method Get -Uri \"http://127.0.0.1:$port/api/health\"\n      if ($health.ok) { $ready = $true; break }\n    } catch {}\n  }\n  if (-not $ready) {\n    Receive-Job -Job $job -Keep | Out-String | Write-Output\n    throw '\"'Server did not become ready.'\n  }\n  return \"'$job\n}\n\n$job1 = $null\n$job2 = $null\ntry {\n  $job1 = Start-App $workspace $port $dbPath\n  $created = Invoke-RestMethod -Method Post -Uri \"http://127.0.0.1:$port/api/todos\" -ContentType '\"'application/json' -Body '{\\\"title\\\":\\\"Restart persistence check\\\"}'\n  Stop-ServerJob \"'$job1 $port\n  $job1 = $null\n\n  $job2 = Start-App $workspace $port $dbPath\n  $todos = Invoke-RestMethod -Method Get -Uri \"http://127.0.0.1:$port/api/todos\"\n  if ($todos.Count -ne 1 -or $todos[0].title -ne '\"'Restart persistence check' -or -not (Test-Path -LiteralPath \"'$dbPath)) {\n    throw '\"'Persistence check failed.'\n  }\n\n  [pscustomobject]@{\n    CreatedId = \"'$created.id\n    PersistedTitle = $todos[0].title\n    DatabasePath = $dbPath\n    DatabaseExists = Test-Path -LiteralPath $dbPath\n  } | Format-List\n} finally {\n  Stop-ServerJob $job1 $port\n  Stop-ServerJob $job2 $port\n  Remove-Item -LiteralPath $dbPath -Force -ErrorAction SilentlyContinue\n}'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
