# ---------------------------------------------------------------------------
# OpenCode — Cloudflare AI Gateway environment variables
# Copy this file to .env (gitignored) and fill in secrets before running.
# ---------------------------------------------------------------------------

# --- Cloudflare AI Gateway (routing) ---------------------------------------
# Used by opencode.example.json to route LLM calls through the gateway.
CF_ACCOUNT_ID=003bd42b347c101d299f719f4d804603
CF_GATEWAY_NAME=lvcorp-ais_services-nonprod
CF_AIG_TOKEN=

# --- OpenCode metadata tags -----------------------------------------------
# Injected as cf-aig-metadata so gateway analytics can slice by app/user.
OPENCODE_APP_TAG=opencode
OPENCODE_USER_TAG=

# --- Cloudflare AI Gateway analytics (benchmark cost capture) --------------
# Used by benchmarks/scripts/gateway-cost.ps1 to pull spend data from the
# Cloudflare Analytics API — the single source of truth for token cost,
# including Workers AI. Falls back to CF_ACCOUNT_ID if
# CLOUDFLARE_ACCOUNT_ID is unset.
# API token scopes required: Account Analytics: Read + AI Gateway: Read.
CLOUDFLARE_ACCOUNT_ID=003bd42b347c101d299f719f4d804603
CLOUDFLARE_API_KEY=
