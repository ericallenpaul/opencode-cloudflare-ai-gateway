# ---------------------------------------------------------------------------
# OpenCode — Cloudflare AI Gateway environment variables
# Copy this file to .env (gitignored) and fill in secrets before running.
# ---------------------------------------------------------------------------

# --- Gateway routing -------------------------------------------------------
# These three vars are required. They route LLM calls through your AI Gateway
# and authenticate against it (CF_AIG_TOKEN).

# Your Cloudflare account ID — 32 hex characters, found top-right of the
# Cloudflare dashboard or in any Worker URL.
CF_ACCOUNT_ID=<your-32-char-cloudflare-account-id>

# The slug you chose when creating the AI Gateway (must match dashboard exactly).
CF_GATEWAY_NAME=<your-gateway-slug>

# Authenticated Gateway token — from the gateway's Settings → Authenticated
# Gateway. Scoped to this gateway only; does NOT grant analytics access.
CF_AIG_TOKEN=

# --- OpenCode metadata tags ------------------------------------------------
# Injected as cf-aig-metadata so gateway analytics can slice by app/user.

# Short identifier for the project/repo. Auto-computed from the git root if
# unset (via plugins/sync-user-env.js), but setting it explicitly is cleaner.
OPENCODE_APP_TAG=opencode

# Short identifier for the developer. Set once per machine — usually $USERNAME.
OPENCODE_USER_TAG=

# --- Cost analytics (optional) ---------------------------------------------
# Used by benchmarks/scripts/gateway-cost.ps1 to pull spend data from the
# Cloudflare GraphQL Analytics API — the authoritative source for token cost
# including Workers AI (ccusage misses Workers AI spend).
#
# Required token scopes: Account Analytics: Read + AI Gateway: Read.
# The token must be bound to the specific account that owns the gateway.
# Create it at: User Profile → API Tokens → Create Token → Custom Token.
#
# CLOUDFLARE_ACCOUNT_ID is the same 32-char account ID as CF_ACCOUNT_ID above.
# It is listed separately because gateway-cost.ps1 reads it by this name;
# if unset, the script falls back to CF_ACCOUNT_ID automatically.

# Preferred: API token with the two scopes above (bearer auth to GraphQL API).
CLOUDFLARE_API_TOKEN=

# Fallback name accepted by gateway-cost.ps1 if CLOUDFLARE_API_TOKEN is unset.
CLOUDFLARE_API_KEY=

# Explicit account ID for analytics calls — falls back to CF_ACCOUNT_ID if unset.
CLOUDFLARE_ACCOUNT_ID=<your-32-char-cloudflare-account-id>

# --- Snyk (optional) ---------------------------------------------------------
# Optional: skip interactive `snyk auth` (useful in CI or SSO-enforced orgs).
# Set to a Snyk API or service-account token. Leave unset to use `snyk auth`.
# SNYK_TOKEN=
